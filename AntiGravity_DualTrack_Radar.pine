//@version=5
indicator("AntiGravity Smart Money Dual-Track Radar [Pro]", overlay=true, max_lines_count=500, max_labels_count=500)

// ==============================================================================
// 1. INPUTS & CONFIGURATION
// ==============================================================================
grp_pivots   = "Pivot & Dynamic Entry Parameters"
pivot_len    = input.int(20, "Pivot Lookback Length (Days)", minval=5, maxval=60, group=grp_pivots)
atr_len      = input.int(14, "ATR Length", minval=5, maxval=30, group=grp_pivots)
atr_mult_ent = input.float(0.15, "Dynamic Entry ATR Buffer", minval=0.05, maxval=0.50, step=0.05, group=grp_pivots)

grp_targets  = "Dynamic Targets & Risk Management"
t1_r_mult    = input.float(2.0, "Target 1 (R-Multiple)", step=0.5, group=grp_targets)
use_fib_ext  = input.bool(true, "Use Fibonacci 1.618 for Target 2", group=grp_targets)
t2_r_mult    = input.float(3.0, "Fallback Target 2 (R-Multiple)", step=0.5, group=grp_targets)
trail_ema_l  = input.int(20, "Multibagger Runner Trailing EMA", minval=10, maxval=50, group=grp_targets)

grp_filters  = "Trend & Squeeze Filters"
sma50_len    = input.int(50, "Daily Trend SMA", group=grp_filters)
sma200_len   = input.int(200, "Macro Base SMA", group=grp_filters)
bb_len       = input.int(20, "Bollinger Band Length", group=grp_filters)
bb_mult      = input.float(2.0, "Bollinger StdDev", group=grp_filters)
show_table   = input.bool(true, "Show Floating HUD Table", group=grp_filters)

// ==============================================================================
// 2. MATHEMATICAL ENGINES
// ==============================================================================
// ATR & Moving Averages
atr_val      = ta.atr(atr_len)
atr_pct      = (atr_val / close) * 100
sma50        = ta.sma(close, sma50_len)
sma200       = ta.sma(close, sma200_len)
trail_ema    = ta.ema(close, trail_ema_l)
vol_sma20    = ta.sma(volume, 20)
rvol         = vol_sma20 > 0 ? (volume / vol_sma20) : 1.0

// Closing Range Ratio (CRR)
day_range    = high - low
crr          = day_range > 0 ? ((close - low) / day_range) : 0.5

// Pivot High & Base Low
pivot_high   = ta.highest(high[1], pivot_len)
base_low     = ta.lowest(low[1], pivot_len)
base_depth   = pivot_high - base_low

// Dynamic Volatility Buffer Entry
dynamic_buffer = math.max(pivot_high * 0.001, atr_mult_ent * atr_val)
entry_trigger  = pivot_high + dynamic_buffer

// Structural Stop Loss & Risk
structural_sl  = base_low - (0.25 * atr_val)
unit_risk      = entry_trigger - structural_sl
risk_pct       = (unit_risk / entry_trigger) * 100

// Dynamic Targets
target_1       = entry_trigger + (t1_r_mult * unit_risk)
fib_t2         = pivot_high + (1.618 * base_depth)
target_2       = use_fib_ext ? math.max(entry_trigger + (t2_r_mult * unit_risk), fib_t2) : (entry_trigger + (t2_r_mult * unit_risk))

// Squeeze Calculation (Bollinger Bandwidth)
[bb_mid, bb_upper, bb_lower] = ta.bb(close, bb_len, bb_mult)
bbw = (bb_upper - bb_lower) / bb_mid * 100
bbw_min120 = ta.lowest(bbw, 120)
bbw_max120 = ta.highest(bbw, 120)
bbw_rank = (bbw_max120 - bbw_min120) > 0 ? ((bbw - bbw_min120) / (bbw_max120 - bbw_min120)) * 100 : 50.0

// Squeeze Detection (Track B)
dist_to_pivot = ((pivot_high - close) / pivot_high) * 100
is_squeeze = (bbw_rank <= 25.0) and (rvol <= 0.85) and (dist_to_pivot <= 5.5) and (dist_to_pivot >= 0.0) and (close >= sma50)

// Active Breakout Detection (Track A)
is_breakout = ta.crossover(close, pivot_high) and (rvol >= 1.5) and (crr >= 0.70) and (close >= sma50)

// ==============================================================================
// 3. PLOTS & VISUALIZATIONS
// ==============================================================================
// Moving Averages
plot(sma50, "50 SMA (Trend)", color=color.new(#38bdf8, 20), linewidth=1)
plot(sma200, "200 SMA (Macro Floor)", color=color.new(#f59e0b, 30), linewidth=2)
plot(trail_ema, "20 EMA (Multibagger Trailing)", color=color.new(#a855f7, 0), linewidth=2)

// Dynamic Key Levels
p_pivot = plot(pivot_high, "20D Pivot High", color=color.new(#94a3b8, 40), style=plot.style_linebr, linewidth=1)
p_entry = plot(entry_trigger, "Dynamic Entry Trigger (+0.15 ATR)", color=color.new(#38bdf8, 0), style=plot.style_linebr, linewidth=2)
p_sl    = plot(structural_sl, "Structural Stop Loss", color=color.new(#f43f5e, 0), style=plot.style_linebr, linewidth=2)
p_t1    = plot(target_1, "Target 1 (+2.0R)", color=color.new(#10b981, 0), style=plot.style_linebr, linewidth=2)
p_t2    = plot(target_2, "Target 2 (Dynamic Fib 1.618)", color=color.new(#06b6d4, 0), style=plot.style_linebr, linewidth=2)

// Shaded Risk / Reward Zones
fill(p_entry, p_sl, color=color.new(#f43f5e, 90), title="Risk Zone (1R)")
fill(p_entry, p_t1, color=color.new(#10b981, 90), title="Reward Zone (T1 2R)")

// Breakout & Squeeze Signals
plotshape(is_breakout, title="Track A Breakout Alert", style=shape.triangleup, location=location.belowbar, color=#10b981, size=size.normal, text="BREAKOUT")
plotshape(is_squeeze and not is_squeeze[1], title="Track B Squeeze Coil Alert", style=shape.diamond, location=location.abovebar, color=#f59e0b, size=size.small, text="COIL")

// ==============================================================================
// 4. FLOATING HUD STATS TABLE
// ==============================================================================
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(#0f172a, 15), border_color=color.new(#334155, 30), border_width=1)

if show_table and barstate.islast
    table.cell(hud, 0, 0, "AntiGravity Dual Radar", bgcolor=color.new(#1e293b, 0), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, is_breakout ? "🚀 ACTIVE BREAKOUT" : (is_squeeze ? "💣 COIL SQUEEZE" : "WAIT / WATCH"), 
               bgcolor=is_breakout ? color.new(#10b981, 20) : (is_squeeze ? color.new(#f59e0b, 20) : color.new(#334155, 20)), 
               text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 1, "Dynamic Entry", text_color=color.new(#94a3b8, 0), text_size=size.tiny)
    table.cell(hud, 1, 1, "₹" + str.tostring(entry_trigger, "#.##") + " (+0.15 ATR)", text_color=color.new(#38bdf8, 0), text_size=size.tiny)

    table.cell(hud, 0, 2, "Stop Loss (1R)", text_color=color.new(#94a3b8, 0), text_size=size.tiny)
    table.cell(hud, 1, 2, "₹" + str.tostring(structural_sl, "#.##") + " (-" + str.tostring(risk_pct, "#.#") + "%)", text_color=color.new(#f43f5e, 0), text_size=size.tiny)

    table.cell(hud, 0, 3, "Target 1 (2R)", text_color=color.new(#94a3b8, 0), text_size=size.tiny)
    table.cell(hud, 1, 3, "₹" + str.tostring(target_1, "#.##") + " (Book 40%)", text_color=color.new(#10b981, 0), text_size=size.tiny)

    table.cell(hud, 0, 4, "Target 2 (Dyn)", text_color=color.new(#94a3b8, 0), text_size=size.tiny)
    table.cell(hud, 1, 4, "₹" + str.tostring(target_2, "#.##") + " (Book 30%)", text_color=color.new(#06b6d4, 0), text_size=size.tiny)

    table.cell(hud, 0, 5, "Runner (30%)", text_color=color.new(#94a3b8, 0), text_size=size.tiny)
    table.cell(hud, 1, 5, "Trail 20 EMA (₹" + str.tostring(trail_ema, "#.##") + ")", text_color=color.new(#a855f7, 0), text_size=size.tiny)

    table.cell(hud, 0, 6, "RVOL / CRR", text_color=color.new(#94a3b8, 0), text_size=size.tiny)
    table.cell(hud, 1, 6, str.tostring(rvol, "#.##") + "x / " + str.tostring(crr, "#.##"), text_color=color.white, text_size=size.tiny)

    table.cell(hud, 0, 7, "BBW Squeeze Rank", text_color=color.new(#94a3b8, 0), text_size=size.tiny)
    table.cell(hud, 1, 7, str.tostring(bbw_rank, "#.#") + "% (" + (bbw_rank <= 25.0 ? "Coiled" : "Normal") + ")", 
               text_color=bbw_rank <= 25.0 ? color.new(#f59e0b, 0) : color.white, text_size=size.tiny)
