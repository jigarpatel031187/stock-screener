//@version=5
indicator("AntiGravity Smart Money Dual-Track Radar [Pro]", shorttitle="AntiGravity Radar", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// 1. INPUTS
grp_display  = "Display Options"
show_lines   = input.bool(true, "Show Target & SL Rays", group=grp_display)
show_zones   = input.bool(true, "Show Risk/Reward Box", group=grp_display)
show_mas     = input.bool(true, "Show MAs (20 EMA, 50, 200 SMA)", group=grp_display)
show_signals = input.bool(true, "Show Breakout / Coil Badges", group=grp_display)
show_table   = input.bool(true, "Show HUD Table", group=grp_display)

grp_params   = "Strategy Parameters"
pivot_len    = input.int(20, "Pivot Length", minval=5, maxval=60, group=grp_params)
atr_len      = input.int(14, "ATR Length", minval=5, maxval=30, group=grp_params)
atr_mult_ent = input.float(0.15, "Dynamic Entry ATR Buffer", minval=0.05, maxval=0.50, step=0.05, group=grp_params)
t1_r_mult    = input.float(2.0, "Target 1 (R-Multiple)", step=0.5, group=grp_params)
use_fib_ext  = input.bool(true, "Use Fibonacci 1.618 for T2", group=grp_params)
t2_r_mult    = input.float(3.0, "Fallback Target 2 (R-Mult)", step=0.5, group=grp_params)
trail_ema_l  = input.int(20, "Trailing EMA Length", minval=10, maxval=50, group=grp_params)

// 2. MATHEMATICAL CORE
atr_val      = ta.atr(atr_len)
atr_pct      = (atr_val / close) * 100
sma50        = ta.sma(close, 50)
sma200       = ta.sma(close, 200)
trail_ema    = ta.ema(close, trail_ema_l)
vol_sma20    = ta.sma(volume, 20)
rvol         = vol_sma20 > 0 ? (volume / vol_sma20) : 1.0

day_range    = high - low
crr          = day_range > 0 ? ((close - low) / day_range) : 0.5

pivot_high   = ta.highest(high[1], pivot_len)
base_low     = ta.lowest(low[1], pivot_len)
base_depth   = pivot_high - base_low

dynamic_buf  = math.max(pivot_high * 0.001, atr_mult_ent * atr_val)
entry_trig   = pivot_high + dynamic_buf

struct_sl    = base_low - (0.25 * atr_val)
unit_risk    = entry_trig - struct_sl
risk_pct     = (unit_risk / entry_trig) * 100

target_1     = entry_trig + (t1_r_mult * unit_risk)
fib_t2       = pivot_high + (1.618 * base_depth)
target_2     = use_fib_ext ? math.max(entry_trig + (t2_r_mult * unit_risk), fib_t2) : (entry_trig + (t2_r_mult * unit_risk))

// Squeeze Calculation
[bb_mid, bb_u, bb_l] = ta.bb(close, 20, 2.0)
bbw          = (bb_u - bb_l) / bb_mid * 100
bbw_min120   = ta.lowest(bbw, 120)
bbw_max120   = ta.highest(bbw, 120)
bbw_rank     = (bbw_max120 - bbw_min120) > 0 ? ((bbw - bbw_min120) / (bbw_max120 - bbw_min120)) * 100 : 50.0

dist_to_piv  = ((pivot_high - close) / pivot_high) * 100
is_squeeze   = (bbw_rank <= 25.0) and (rvol <= 0.85) and (dist_to_piv <= 5.5) and (dist_to_piv >= 0.0) and (close >= sma50)
is_breakout  = ta.crossover(close, pivot_high) and (rvol >= 1.5) and (crr >= 0.70) and (close >= sma50)

fire_breakout = is_breakout and not is_breakout[1]
fire_squeeze  = is_squeeze and not is_squeeze[1]

// 3. MOVING AVERAGES
plot(show_mas ? trail_ema : na, "20 EMA", color=#A855F7, linewidth=2)
plot(show_mas ? sma50 : na, "50 SMA", color=#38BDF8, linewidth=2)
plot(show_mas ? sma200 : na, "200 SMA", color=#F59E0B, linewidth=2)

// 4. SIGNALS
plotshape(show_signals and fire_breakout, title="Breakout", style=shape.labelup, location=location.belowbar, color=#10B981, text="BREAKOUT", textcolor=color.white, size=size.small)
plotshape(show_signals and fire_squeeze, title="Coil", style=shape.labeldown, location=location.abovebar, color=#F59E0B, text="COIL", textcolor=color.black, size=size.small)

// 5. SETUP RAYS & LABELS
var line ln_piv = na
var line ln_ent = na
var line ln_sl  = na
var line ln_t1  = na
var line ln_t2  = na

var label lb_ent = na
var label lb_sl  = na
var label lb_t1  = na
var label lb_t2  = na
var box   bx_rsk = na
var box   bx_rwd = na

if show_lines and barstate.islast
    line.delete(ln_piv)
    line.delete(ln_ent)
    line.delete(ln_sl)
    line.delete(ln_t1)
    line.delete(ln_t2)
    label.delete(lb_ent)
    label.delete(lb_sl)
    label.delete(lb_t1)
    label.delete(lb_t2)
    box.delete(bx_rsk)
    box.delete(bx_rwd)

    int x1 = bar_index - 15
    int x2 = bar_index + 12

    ln_piv := line.new(x1, pivot_high, x2, pivot_high, color=#94A3B8, width=1, style=line.style_dashed)
    ln_ent := line.new(x1, entry_trig, x2, entry_trig, color=#00E5FF, width=2)
    ln_sl  := line.new(x1, struct_sl, x2, struct_sl, color=#FF3B69, width=2)
    ln_t1  := line.new(x1, target_1, x2, target_1, color=#00E676, width=2)
    ln_t2  := line.new(x1, target_2, x2, target_2, color=#FFD600, width=2)

    string str_ent = "BUY > " + str.tostring(entry_trig, "#.##")
    string str_sl  = "SL: " + str.tostring(struct_sl, "#.##") + " (-" + str.tostring(risk_pct, "#.#") + "%)"
    string str_t1  = "T1 (2R): " + str.tostring(target_1, "#.##") + " [40%]"
    string str_t2  = "T2 (Dyn): " + str.tostring(target_2, "#.##") + " [30%]"

    lb_ent := label.new(x2, entry_trig, str_ent, color=#00E5FF, textcolor=#0F172A, style=label.style_label_left, size=size.small)
    lb_sl  := label.new(x2, struct_sl, str_sl, color=#FF3B69, textcolor=color.white, style=label.style_label_left, size=size.small)
    lb_t1  := label.new(x2, target_1, str_t1, color=#00E676, textcolor=#0F172A, style=label.style_label_left, size=size.small)
    lb_t2  := label.new(x2, target_2, str_t2, color=#FFD600, textcolor=#0F172A, style=label.style_label_left, size=size.small)

    if show_zones
        bx_rsk := box.new(x1, entry_trig, x2, struct_sl, border_color=color.new(#FF3B69, 70), bgcolor=color.new(#FF3B69, 88))
        bx_rwd := box.new(x1, target_1, x2, entry_trig, border_color=color.new(#00E676, 70), bgcolor=color.new(#00E676, 88))

// 6. HUD TABLE
var table hud = table.new(position.bottom_left, 2, 8, bgcolor=color.new(#0F172A, 0), border_color=color.new(#334155, 0), border_width=2)

if show_table and barstate.islast
    table.cell(hud, 0, 0, "AntiGravity Radar", bgcolor=#1E293B, text_color=#38BDF8, text_size=size.small)
    string st_txt = is_breakout ? "BREAKOUT" : (is_squeeze ? "COIL" : "WATCH")
    color st_bg = is_breakout ? #10B981 : (is_squeeze ? #F59E0B : #334155)
    color st_fg = is_breakout or is_squeeze ? #0F172A : #F8FAFC
    table.cell(hud, 1, 0, st_txt, bgcolor=st_bg, text_color=st_fg, text_size=size.small)

    table.cell(hud, 0, 1, "Buy Above", text_color=#94A3B8, text_size=size.small)
    table.cell(hud, 1, 1, str.tostring(entry_trig, "#.##") + " (+0.15 ATR)", text_color=#00E5FF, text_size=size.small)

    table.cell(hud, 0, 2, "Stop Loss", text_color=#94A3B8, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(struct_sl, "#.##") + " (-" + str.tostring(risk_pct, "#.#") + "%)", text_color=#FF3B69, text_size=size.small)

    table.cell(hud, 0, 3, "Target 1 (2R)", text_color=#94A3B8, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(target_1, "#.##") + " [Book 40%]", text_color=#00E676, text_size=size.small)

    table.cell(hud, 0, 4, "Target 2 (Dyn)", text_color=#94A3B8, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(target_2, "#.##") + " [Book 30%]", text_color=#FFD600, text_size=size.small)

    table.cell(hud, 0, 5, "Runner (30%)", text_color=#94A3B8, text_size=size.small)
    table.cell(hud, 1, 5, "Trail 20 EMA (" + str.tostring(trail_ema, "#.##") + ")", text_color=#C084FC, text_size=size.small)

    table.cell(hud, 0, 6, "RVOL / CRR", text_color=#94A3B8, text_size=size.small)
    table.cell(hud, 1, 6, str.tostring(rvol, "#.##") + "x  |  " + str.tostring(crr, "#.##"), text_color=#F8FAFC, text_size=size.small)

    table.cell(hud, 0, 7, "Squeeze Rank", text_color=#94A3B8, text_size=size.small)
    string coil_lbl = bbw_rank <= 25.0 ? "Coiled" : "Normal"
    color coil_col = bbw_rank <= 25.0 ? #F59E0B : #94A3B8
    table.cell(hud, 1, 7, str.tostring(bbw_rank, "#.#") + "% (" + coil_lbl + ")", text_color=coil_col, text_size=size.small)
